# Copy to .env and paste your keys. Leave a line empty to skip that provider.
ANTHROPIC_API_KEY=
# Only if your Anthropic key is not scoped to a workspace (Console > Workspaces, id starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
# Reddit Data API, read-only: create a 'script' app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Live sources for Warrant, test accounts only: a HubSpot developer test account private app token, a Chargebee test site and test key
HUBSPOT_TOKEN=
CHARGEBEE_SITE=
CHARGEBEE_API_KEY=
# Slack test workspace: bot token, app-level token for Socket Mode, channel id or name
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=
SERPER_API_KEY=
